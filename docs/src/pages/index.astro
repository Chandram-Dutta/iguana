</style>

<script>
	// One small desktop tells the whole page. It is a real, if small, tiling engine: every
	// window has a place in a tree of splits, a new window halves the focused one along its
	// longer side, and the shortcuts move the focus or the window through that tree. The scroll
	// position only chooses the chapter; inside a chapter the desktop acts by itself, and in the
	// last one it listens to the keyboard.

	type Rect = { x: number; y: number; w: number; h: number };
	type Leaf = { id: number; color: string };
	type Split = { dir: 'h' | 'v'; ratio: number; a: Node; b: Node };
	type Node = Leaf | Split;
	type Direction = 'left' | 'right' | 'up' | 'down';
	type Step = { split: Split; side: 'a' | 'b' };

	const isLeaf = (n: Node): n is Leaf => 'id' in n;

	const story = document.querySelector<HTMLElement>('[data-story]');
	if (story) {
		const pin = story.querySelector<HTMLElement>('.pin')!;
		const desk = story.querySelector<HTMLElement>('[data-desk]')!;
		const display = story.querySelector<HTMLElement>('[data-display]')!;
		const status = story.querySelector<HTMLElement>('[data-status]')!;
		const glow = story.querySelector<HTMLElement>('[data-glow]')!;
		const glyph = story.querySelector<SVGSVGElement>('[data-glyph]')!;
		const number = story.querySelector<HTMLElement>('[data-number]')!;
		const cue = story.querySelector<HTMLElement>('[data-cue]')!;
		const power = story.querySelector<HTMLElement>('[data-power]');
		const captions = Array.from(story.querySelectorAll<HTMLElement>('.caption'));
		const marks = Array.from(story.querySelectorAll<HTMLElement>('.rail li'));
		const openButton = story.querySelector<HTMLButtonElement>('[data-action="open"]')!;
		const closeButton = story.querySelector<HTMLButtonElement>('[data-action="close"]')!;
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const steps = captions.length;
		const last = steps - 1;

		const colors = ['fern', 'lime', 'dew', 'amber', 'moss'];
		const hues: Record<string, string> = { fern: '#18a67e', lime: '#8fd43f', dew: '#d5f0a0', amber: '#f2b84b', moss: '#4d8f6c' };
		const limit = 5;

		// ---- The world: three desktops, each with its own tree --------------------------------

		let desks: (Node | null)[] = [null, null, null];
		let focus: (number | null)[] = [null, null, null];
		let active = 0;
		let overview = false;
		let running = true;
		let gaps = { inner: 11, outer: 0 };
		let shiftLatched = false;
		const tiles = new Map<number, HTMLElement>();

		const panels = desks.map((_, i) => {
			const panel = document.createElement('div');
			panel.className = 'panel';
			panel.innerHTML = `<span>${i + 1}</span>`;
			desk.append(panel);
			return panel;
		});

		function leaves(node: Node | null, out: Leaf[] = []): Leaf[] {
			if (!node) return out;
			if (isLeaf(node)) out.push(node);
			else {
				leaves(node.a, out);
				leaves(node.b, out);
			}
			return out;
		}

		function place(node: Node | null, r: Rect, gap: number, out = new Map<number, Rect>()): Map<number, Rect> {
			if (!node) return out;
			if (isLeaf(node)) {
				out.set(node.id, r);
			} else if (node.dir === 'h') {
				const w = (r.w - gap) * node.ratio;
				place(node.a, { x: r.x, y: r.y, w, h: r.h }, gap, out);
				place(node.b, { x: r.x + w + gap, y: r.y, w: r.w - gap - w, h: r.h }, gap, out);
			} else {
				const h = (r.h - gap) * node.ratio;
				place(node.a, { x: r.x, y: r.y, w: r.w, h }, gap, out);
				place(node.b, { x: r.x, y: r.y + h + gap, w: r.w, h: r.h - gap - h }, gap, out);
			}
			return out;
		}

		function path(id: number, node: Node | null, trail: Step[] = []): Step[] | null {
			if (!node) return null;
			if (isLeaf(node)) return node.id === id ? trail : null;
			return path(id, node.a, [...trail, { split: node, side: 'a' }]) ?? path(id, node.b, [...trail, { split: node, side: 'b' }]);
		}

		/** Where a desktop is drawn: filling the screen, or one of three when the view pulls back. */
		function room(index: number): Rect {
			const W = desk.clientWidth;
			const H = desk.clientHeight;
			if (!overview) return { x: (index - active) * (W + 60), y: 0, w: W, h: H };
			const between = W * 0.035;
			const w = (W - between * 2) / 3;
			const h = (w * H) / W;
			return { x: index * (w + between), y: (H - h) / 2 - 8, w, h };
		}

		function frames(index: number): Map<number, Rect> {
			const r = room(index);
			const scale = r.w / Math.max(desk.clientWidth, 1);
			const narrow = desk.clientWidth < 460 ? 0.65 : 1;
			const edge = (overview ? Math.max(gaps.outer, 6) : gaps.outer) * scale * narrow;
			const gap = Math.max(gaps.inner * scale * narrow, overview ? 3 : 0);
			return place(desks[index], { x: r.x + edge, y: r.y + edge, w: r.w - edge * 2, h: r.h - edge * 2 }, gap);
		}

		function neighbour(direction: Direction): number | null {
			const from = focus[active];
			if (from === null) return null;
			const all = frames(active);
			const origin = all.get(from);
			if (!origin) return null;
			let best: { id: number; score: number } | null = null;
			for (const [id, r] of all) {
				if (id === from) continue;
				const horizontal = direction === 'left' || direction === 'right';
				const ahead =
					direction === 'left' ? origin.x - (r.x + r.w)
					: direction === 'right' ? r.x - (origin.x + origin.w)
					: direction === 'up' ? origin.y - (r.y + r.h)
					: r.y - (origin.y + origin.h);
				if (ahead < -1) continue;
				const overlap = horizontal
					? Math.min(origin.y + origin.h, r.y + r.h) - Math.max(origin.y, r.y)
					: Math.min(origin.x + origin.w, r.x + r.w) - Math.max(origin.x, r.x);
				const offset = horizontal
					? Math.abs(r.y + r.h / 2 - (origin.y + origin.h / 2))
					: Math.abs(r.x + r.w / 2 - (origin.x + origin.w / 2));
				const score = (overlap > 1 ? 0 : 100000) + ahead * 10 + offset;
				if (!best || score < best.score) best = { id, score };
			}
			return best?.id ?? null;
		}

		// ---- What the shortcuts do ------------------------------------------------------------

		/** Add a window to a desktop the way Iguana does: split the focused one along its longer side. */
		function adopt(leaf: Leaf, index: number) {
			const root = desks[index];
			const anchor = focus[index];
			if (!root || anchor === null) {
				desks[index] = leaf;
			} else {
				const rect = frames(index).get(anchor)!;
				const trail = path(anchor, root)!;
				const current = leaves(root).find((l) => l.id === anchor)!;
				const split: Split = { dir: rect.w >= rect.h ? 'h' : 'v', ratio: 0.5, a: current, b: leaf };
				const parent = trail.at(-1);
				if (parent) parent.split[parent.side] = split;
				else desks[index] = split;
			}
			focus[index] = leaf.id;
		}

		function detach(id: number, index: number) {
			const trail = path(id, desks[index]);
			if (!trail) return;
			const parent = trail.at(-1);
			if (!parent) {
				desks[index] = null;
				focus[index] = null;
				return;
			}
			const sibling = parent.split[parent.side === 'a' ? 'b' : 'a'];
			const grand = trail.at(-2);
			if (grand) grand.split[grand.side] = sibling;
			else desks[index] = sibling;
			focus[index] = leaves(sibling)[0].id;
		}

		function unused(): number {
			const taken = new Set(desks.flatMap((d) => leaves(d).map((l) => l.id)));
			let id = 1;
			while (taken.has(id)) id++;
			return id;
		}

		function open(): boolean {
			if (leaves(desks[active]).length >= limit) return false;
			const id = unused();
			adopt({ id, color: colors[(id - 1) % colors.length] }, active);
			return true;
		}

		function close(): boolean {
			const id = focus[active];
			if (id === null) return false;
			detach(id, active);
			return true;
		}

		function moveFocus(direction: Direction): boolean {
			const target = neighbour(direction);
			if (target === null) return false;
			focus[active] = target;
			return true;
		}

		function moveWindow(direction: Direction): boolean {
			const target = neighbour(direction);
			const id = focus[active];
			if (target === null || id === null) return false;
			const all = leaves(desks[active]);
			const a = all.find((l) => l.id === id)!;
			const b = all.find((l) => l.id === target)!;
			[a.id, b.id] = [b.id, a.id];
			[a.color, b.color] = [b.color, a.color];
			return true;
		}

		function resize(grow: boolean): boolean {
			const id = focus[active];
			if (id === null) return false;
			const step = path(id, desks[active])?.at(-1);
			if (!step) return false;
			const delta = (grow ? 0.07 : -0.07) * (step.side === 'a' ? 1 : -1);
			const next = Math.min(0.78, Math.max(0.22, step.split.ratio + delta));
			if (next === step.split.ratio) return false;
			step.split.ratio = next;
			return true;
		}

		/** Take the focused window to another desktop, and go with it. */
		function carry(to: number) {
			const id = focus[active];
			if (id === null || to === active) return;
			const leaf = leaves(desks[active]).find((l) => l.id === id)!;
			detach(id, active);
			adopt({ ...leaf }, to);
			active = to;
		}

		/** A desktop tiled from scratch, with the same windows as before so that they glide into place. */
		function arrange(index: number, ids: number[]) {
			desks[index] = null;
			focus[index] = null;
			for (const id of ids) adopt({ id, color: colors[(id - 1) % colors.length] }, index);
		}

		// ---- Drawing --------------------------------------------------------------------------

		function render() {
			const shown = new Set<number>();
			pin.classList.toggle('is-overview', overview);
			panels.forEach((panel, i) => {
				const r = room(i);
				panel.style.width = `${r.w}px`;
				panel.style.height = `${r.h}px`;
				panel.style.transform = `translate(${r.x}px, ${r.y}px)`;
				panel.classList.toggle('is-active', overview && i === active);
			});

			desks.forEach((root, index) => {
				const all = frames(index);
				for (const leaf of leaves(root)) {
					const r = all.get(leaf.id)!;
					shown.add(leaf.id);
					let tile = tiles.get(leaf.id);
					if (!tile) {
						tile = document.createElement('div');
						tile.className = 'tile is-entering';
						tile.dataset.id = String(leaf.id);
						tile.addEventListener('click', () => {
							if (step !== last) return;
							const owner = desks.findIndex((d) => leaves(d).some((l) => l.id === leaf.id));
							if (owner !== active) return;
							focus[active] = leaf.id;
							render();
						});
						desk.append(tile);
						tiles.set(leaf.id, tile);
						tile.style.width = `${r.w}px`;
						tile.style.height = `${r.h}px`;
						tile.style.transform = `translate(${r.x}px, ${r.y}px) scale(0.9)`;
						void tile.offsetWidth;
						tile.classList.remove('is-entering');
					}
					tile.dataset.color = leaf.color;
					tile.style.width = `${r.w}px`;
					tile.style.height = `${r.h}px`;
					tile.style.transform = `translate(${r.x}px, ${r.y}px)`;
					tile.classList.toggle('is-focused', index === active && leaf.id === focus[index]);
					tile.classList.toggle('is-small', r.w < 120 || r.h < 90);
					tile.classList.toggle('is-away', !overview && index !== active);
				}
			});

			for (const [id, tile] of tiles) {
				if (shown.has(id)) continue;
				tiles.delete(id);
				tile.classList.add('is-leaving');
				window.setTimeout(() => tile.remove(), 280);
			}

			const here = leaves(desks[active]);
			const focused = here.find((l) => l.id === focus[active]);
			glow.style.backgroundColor = hues[focused?.color ?? 'fern'];
			number.textContent = String(active + 1);
			glyph.classList.toggle('is-off', !running);
			if (power) power.classList.toggle('is-on', running);
			openButton.disabled = here.length >= limit;
			closeButton.disabled = here.length === 0;
			drawGlyph();
		}

		/** The menu bar icon: the layout of the desktop in use, twenty-two units wide. */
		function drawGlyph() {
			const small = place(desks[active], { x: 0, y: 0, w: 22, h: 14 }, 1.5);
			for (const rect of Array.from(glyph.querySelectorAll('rect[data-id]'))) {
				if (!small.has(Number((rect as SVGRectElement).dataset.id))) rect.remove();
			}
			let outline = glyph.querySelector<SVGRectElement>('[data-outline]');
			if (!outline) {
				outline = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
				outline.dataset.outline = '';
				for (const [name, value] of Object.entries({ x: 1, y: 1, width: 20, height: 12, rx: 3, fill: 'none', stroke: 'currentColor', 'stroke-width': 1.3 })) {
					outline.setAttribute(name, String(value));
				}
				glyph.append(outline);
			}
			outline.setAttribute('opacity', small.size === 0 ? '0.7' : '0');
			for (const [id, r] of small) {
				let rect = glyph.querySelector<SVGRectElement>(`rect[data-id="${id}"]`);
				if (!rect) {
					rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
					rect.dataset.id = String(id);
					rect.setAttribute('fill', 'currentColor');
					glyph.append(rect);
				}
				rect.setAttribute('x', String(r.x));
				rect.setAttribute('y', String(r.y));
				rect.setAttribute('width', String(Math.max(r.w, 1)));
				rect.setAttribute('height', String(Math.max(r.h, 1)));
				rect.setAttribute('rx', String(Math.min(2.4, r.w / 2, r.h / 2)));
				rect.setAttribute('opacity', id === focus[active] || small.size === 1 ? '1' : '0.4');
			}
		}

		/** Light the keys of the chapter on screen, or of the real deck in the last one. */
		function press(names: string[]) {
			const scope = captions[step];
			for (const name of names) {
				const key = scope.querySelector<HTMLElement>(`[data-cap="${name}"], [data-key="${name}"]`);
				if (!key) continue;
				key.classList.add('is-down');
				window.setTimeout(() => key.classList.remove('is-down'), 260);
			}
		}

		// ---- The chapters ---------------------------------------------------------------------

		const arrows: Record<string, Direction> = { h: 'left', j: 'down', k: 'up', l: 'right' };
		let step = -1;
		let beat = 0;
		let ticker = 0;

		/** Put the desktop in the state a chapter starts from. The windows keep their identity,
		    so whatever came before, they glide to where the chapter needs them. */
		function enter(chapter: number) {
			overview = false;
			running = true;
			active = 0;
			beat = 0;
			pin.classList.toggle('is-playing', chapter === last);
			pin.classList.toggle('is-yours', chapter === last);
			const name = captions[chapter].dataset.chapter;

			if (chapter === 0 || name === 'place') {
				arrange(0, [1, 2, 3]);
				desks[1] = desks[2] = null;
			} else if (name === 'desktops') {
				overview = true;
				arrange(0, [1, 2, 3]);
				arrange(1, [4]);
				desks[2] = null;
				focus[2] = null;
				focus[0] = 3;
			} else {
				arrange(0, [1, 2, 3, 4]);
				desks[1] = desks[2] = null;
			}
			render();
		}

		/** One beat of a chapter acting itself out. */
		function act(chapter: number) {
			const name = captions[chapter].dataset.chapter;
			if (name === 'place') {
				// Windows open one after another, then close again: each time the rest make room.
				const moves = ['open', 'open', 'close', 'close', 'close', 'open'];
				if (moves[beat % moves.length] === 'open') open();
				else close();
			} else if (name === 'focus') {
				const key = ['h', 'k', 'l', 'j', 'l', 'h'][beat % 6];
				moveFocus(arrows[key]);
				press(['option', key]);
			} else if (name === 'move') {
				const key = ['h', 'h', 'l', 'l'][beat % 4];
				moveWindow(arrows[key]);
				press(['option', 'shift', key]);
			} else if (name === 'resize') {
				const grow = beat % 4 < 2;
				resize(grow);
				press(['option', grow ? 'equal' : 'minus']);
			} else if (name === 'desktops') {
				// Go to a desktop; then take a window along to the next.
				const moves: [string, number][] = [['go', 1], ['carry', 2], ['go', 0], ['go', 2], ['carry', 1], ['go', 0]];
				const [kind, to] = moves[beat % moves.length];
				if (kind === 'go') {
					active = to;
					press(['option', `d${to + 1}`]);
				} else {
					carry(to);
					press(['option', 'shift', `d${to + 1}`]);
				}
			} else if (name === 'quit') {
				running = !running;
			} else {
				return;
			}
			beat += 1;
			render();
		}

		function go(next: number) {
			if (next === step) return;
			step = next;
			captions.forEach((caption, i) => {
				caption.classList.toggle('is-on', i === step);
				caption.classList.toggle('is-past', i < step);
				caption.toggleAttribute('inert', i !== step);
			});
			marks.forEach((mark, i) => {
				mark.classList.toggle('is-here', i === step);
				mark.classList.toggle('is-done', i < step);
			});
			cue.classList.toggle('is-gone', step > 0);
			status.textContent = captions[step].querySelector('h1, h2')?.textContent ?? '';
			window.clearInterval(ticker);
			enter(step);
			if (!reduced && step > 0 && step < last) {
				ticker = window.setInterval(() => act(step), captions[step].dataset.chapter === 'quit' ? 1700 : 1150);
			}
		}

		let held = false;
		function measure() {
			if (held) return;
			const top = story!.offsetTop;
			const span = story!.offsetHeight - window.innerHeight;
			const progress = Math.min(Math.max((window.scrollY - top) / Math.max(span, 1), 0), 0.9999);
			go(Math.floor(progress * steps));
		}

		// The page opens with an empty desktop that fills up, once.
		if (reduced || window.scrollY > 40) {
			measure();
		} else {
			step = 0;
			marks[0]?.classList.add('is-here');
			captions.forEach((caption, i) => caption.toggleAttribute('inert', i !== 0));
			render();
			let opened = 0;
			const fill = window.setInterval(() => {
				if (step !== 0 || opened >= 3) {
					window.clearInterval(fill);
					return;
				}
				open();
				opened += 1;
				render();
			}, 520);
		}

		let queued = false;
		window.addEventListener(
			'scroll',
			() => {
				if (queued) return;
				queued = true;
				window.requestAnimationFrame(() => {
					queued = false;
					measure();
				});
			},
			{ passive: true }
		);
		new ResizeObserver(() => render()).observe(desk);

		for (const button of Array.from(story.querySelectorAll<HTMLButtonElement>('[data-go]'))) {
			button.addEventListener('click', () => {
				const span = story.offsetHeight - window.innerHeight;
				const target = story.offsetTop + ((Number(button.dataset.go) + 0.5) / steps) * span;
				window.scrollTo({ top: target, behavior: reduced ? 'auto' : 'smooth' });
			});
		}

		// For looking at one chapter without scrolling to it: /?chapter=5 shows it and holds it.
		const asked = new URLSearchParams(window.location.search).get('chapter');
		if (asked !== null) {
			held = true;
			go(Math.min(Math.max(Number(asked) || 0, 0), last));
			// Something to keep time passing for a browser that takes a picture when the page goes quiet.
			window.setInterval(() => {}, 250);
		}

		// ---- The last chapter: the keys are yours ---------------------------------------------

		function command(key: string, shift: boolean) {
			if (step !== last) return;
			pin.classList.remove('is-yours');
			if (key in arrows) {
				press(shift ? ['option', 'shift', key] : ['option', key]);
				if (shift) moveWindow(arrows[key]);
				else moveFocus(arrows[key]);
			} else if (key === 'minus' || key === 'equal') {
				press(['option', key]);
				resize(key === 'equal');
			} else if (key === 'open') {
				open();
			} else if (key === 'close') {
				close();
			}
			render();
		}

		const codes: Record<string, string> = {
			KeyH: 'h', KeyJ: 'j', KeyK: 'k', KeyL: 'l',
			ArrowLeft: 'h', ArrowDown: 'j', ArrowUp: 'k', ArrowRight: 'l',
			Minus: 'minus', Equal: 'equal',
		};

		window.addEventListener('keydown', (event) => {
			if (step !== last) return;
			if (event.key === 'Alt' || event.key === 'Shift') {
				captions[last].querySelector(`[data-key="${event.key === 'Alt' ? 'option' : 'shift'}"]`)?.classList.add('is-down');
				return;
			}
			if (event.metaKey || event.ctrlKey) return;
			// The sliders keep their own keys.
			const target = event.target as HTMLElement | null;
			if (target && (target.tagName === 'INPUT' || target.isContentEditable)) return;
			const onDesk = document.activeElement === display;
			// Option is not required. Someone who already runs Iguana would never get a key through
			// with it: the real thing takes Option H J K L before the browser sees them. The arrow
			// keys are left to scrolling unless Option is held or the desktop has the keyboard.
			const arrow = event.code.startsWith('Arrow');
			if (arrow && !event.altKey && !onDesk) return;
			const key = codes[event.code];
			if (key) {
				event.preventDefault();
				command(key, event.shiftKey);
			} else if (event.code === 'KeyN' || (onDesk && event.code === 'Enter')) {
				event.preventDefault();
				command('open', false);
			} else if (event.code === 'KeyW' || (onDesk && event.code === 'Backspace')) {
				event.preventDefault();
				command('close', false);
			}
		});
		window.addEventListener('keyup', (event) => {
			if (event.key === 'Alt') captions[last].querySelector('[data-key="option"]')?.classList.remove('is-down');
			if (event.key === 'Shift') captions[last].querySelector('[data-key="shift"]')?.classList.remove('is-down');
		});

		for (const button of Array.from(story.querySelectorAll<HTMLButtonElement>('[data-key]'))) {
			button.addEventListener('click', () => {
				const key = button.dataset.key!;
				if (key === 'shift') {
					// On a touch screen there is nothing to hold: tap shift to keep it down.
					shiftLatched = !shiftLatched;
					button.setAttribute('aria-pressed', String(shiftLatched));
				} else if (key !== 'option') {
					command(key, shiftLatched);
				}
			});
		}
		openButton.addEventListener('click', () => command('open', false));
		closeButton.addEventListener('click', () => command('close', false));

		for (const input of Array.from(story.querySelectorAll<HTMLInputElement>('[data-gap]'))) {
			const name = input.dataset.gap as 'inner' | 'outer';
			input.addEventListener('input', () => {
				gaps[name] = Number(input.value);
				const shown = story.querySelector<HTMLElement>(`[data-value="${name}"]`);
				if (shown) shown.textContent = input.value;
				render();
			});
		}
	}

	// The Homebrew commands, to the clipboard.
	const copy = document.querySelector<HTMLButtonElement>('[data-copy]');
	const commands = document.querySelector<HTMLElement>('[data-brew]');
	if (copy && commands) {
		copy.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(commands.textContent ?? '');
				copy.textContent = 'Copied';
			} catch {
				copy.textContent = 'Select and copy';
			}
			window.setTimeout(() => (copy.textContent = 'Copy'), 1600);
		});
	}
</script>
