	}
	.is-overview .panel {
		opacity: 1;
	}
	.panel.is-active {
		box-shadow: 0 0 0 2.5px var(--text);
	}
	.panel span {
		position: absolute;
		left: 50%;
		top: calc(100% + 0.7rem);
		translate: -50% 0;
		display: grid;
		place-items: center;
		width: 1.7rem;
		height: 1.7rem;
