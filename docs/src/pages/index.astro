	.tile {
		position: absolute;
		top: 0;
		left: 0;
		border-radius: 13px;
		background: var(--tile);
		box-shadow: 0 6px 16px -8px rgba(0, 0, 0, 0.5);
		transition:
			transform var(--move) var(--ease),
			width var(--move) var(--ease),
			height var(--move) var(--ease),
			border-radius var(--move) var(--ease),
			opacity 0.25s,
			box-shadow 0.2s;
		overflow: hidden;
	}
	.is-playing .tile {
		cursor: pointer;
	}
	.tile::before {
		content: '';
		position: absolute;
		top: 11px;
		left: 12px;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: rgba(0, 0, 0, 0.2);
		box-shadow:
			12px 0 0 rgba(0, 0, 0, 0.2),
			24px 0 0 rgba(0, 0, 0, 0.2);
		transition: opacity 0.2s;
	}
	.tile::after {
		content: '';
		position: absolute;
		top: 32px;
		left: 12px;
		width: 34%;
		height: 7px;
		border-radius: 4px;
		background: rgba(0, 0, 0, 0.16);
		box-shadow:
			0 14px 0 rgba(0, 0, 0, 0.1),
