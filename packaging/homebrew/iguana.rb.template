# The Homebrew cask for Iguana. scripts/release.sh fills in the version, the checksum and the
# address, and writes the result to dist/iguana.rb; scripts/publish.sh puts that file in the tap.
cask "iguana" do
  version "{{VERSION}}"
  sha256 "{{SHA256}}"

  url "{{URL_BASE}}/v#{version}/Iguana-#{version}.zip"
  name "Iguana"
  desc "Keyboard-driven tiling window manager"
  homepage "{{HOMEPAGE}}"

  livecheck do
    url :url
    strategy :github_latest
  end

  # Iguana installs its own updates, so a plain `brew upgrade` leaves it to the app.
  auto_updates true
  depends_on macos: :sonoma

  app "Iguana.app"
  # The app's binary is also the command line tool.
  binary "#{appdir}/Iguana.app/Contents/MacOS/iguana"

  uninstall quit: "xyz.onlychan.iguana"

  zap trash: [
    "~/.config/iguana",
    "~/Library/Application Support/Iguana",
    "~/Library/Logs/Iguana.log",
    "~/Library/Preferences/xyz.onlychan.iguana.plist",
  ]
end
